# SupportDesk environment configuration
# Copy this file to .env and fill in real values before running.
# Never commit real secrets to version control.

# LLM provider: NVIDIA Build API via langchain-nvidia-ai-endpoints (ChatNVIDIA)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# LLM retry / fallback middleware
LLM_MAX_RETRIES=3
LLM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

# Tool gate / risk policy
REFUND_AUTO_APPROVE_THRESHOLD=100.00
MAX_TOOL_VALIDATION_FAILURES=2
MAX_REVISIONS=1
ROUTER_CONFIDENCE_THRESHOLD=0.70

# Database (SQLite locally, Postgres in docker-compose)
DATABASE_URL=sqlite:///./supportdesk.db

# Application
APP_ENV=development
LOG_LEVEL=INFO
